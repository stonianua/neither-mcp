{
  "name": "neither-mcp",
  "version": "0.1.2",
  "description": "Decision memory for your coding agent: it stops re-proposing what your team already rejected, and cites why.",
  "settings": [
    {
      "name": "Neither API Key",
      "description": "API key from https://www.neither.online/start/?product=dev (NEITHER_API_KEY).",
      "envVar": "NEITHER_API_KEY",
      "sensitive": true
    }
  ],
  "mcpServers": {
    "neither": {
      "command": "npx",
      "args": ["-y", "@neitherai/mcp-server@0.1.3"],
      "env": {
        "NEITHER_API_KEY": "${NEITHER_API_KEY}",
        "NEITHER_API_BASE": "https://api.neither.online"
      }
    }
  }
}