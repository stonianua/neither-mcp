{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.stonianua/neither-mcp",
  "description": "Decision memory for your coding agent: stops re-proposing what your team rejected, and cites why.",
  "websiteUrl": "https://www.neither.online/start/?product=dev&utm_source=mcp-registry",
  "repository": {
    "url": "https://github.com/stonianua/neither-mcp",
    "source": "github"
  },
  "version": "0.1.5",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@neitherai/mcp-server",
      "version": "0.1.3",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Workspace API key from https://www.neither.online/start/?product=dev&utm_source=mcp-registry",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "NEITHER_API_KEY"
        },
        {
          "description": "API host (default https://api.neither.online)",
          "format": "string",
          "default": "https://api.neither.online",
          "name": "NEITHER_API_BASE"
        }
      ]
    }
  ]
}
